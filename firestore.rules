rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read everywhere
    match /{document=**} {
      allow read: if true;
    }

    // Contributors can write their own profile
    match /users/{userId} {
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'phone', 'isBanned', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.isBanned is bool
        && request.resource.data.updatedAt is timestamp;
    }

    // Contributors can mark artist attributes; any other field changes are rejected
    match /artistsWhitelist/{docId} {
      allow write: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isFemale', 'isChasid', 'isGenZ', 'isVerified', 'verifiedBy', 'verifiedAt'])
        && request.resource.data.verifiedBy == request.auth.uid;
    }

    // Artist/song reports: anyone can submit a pending report; only signed-in users can update status.
    match /artistReports/{reportId} {
      allow create: if request.resource.data.status == "pending"
        && request.resource.data.artistId is string
        && request.resource.data.reason is string
        && (!('comment' in request.resource.data) || request.resource.data.comment is string)
        && (!('reporterUid' in request.resource.data) || request.resource.data.reporterUid is string)
        // Allow serverTimestamp or any provided timestamp
        && ('createdAt' in request.resource.data);

      allow update: if request.auth != null
        && request.resource.data.status in ["pending", "approved", "rejected"];

      allow delete: if false;
    }

    // Default: no writes elsewhere
    match /{document=**} {
      allow write: if false;
    }
  }
}
