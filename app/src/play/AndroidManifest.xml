<?xml version="1.0" encoding="utf-8"?>
<!--
  Google Play flavor manifest overlay.

  Strips entries that are Google Play policy blockers and are excluded from the play build:
    - In-app self-updater (Device & Network Abuse): the install permission, install-status
      receiver, and the privileged-install provider.
    - Accessibility button-mapper (Accessibility API misuse): the accessibility service.
    - Unused / Play-scrutinized permissions: overlay (no system overlay is created) and
      receive-boot-completed (no boot receiver).
    - Advertising ID: auto-merged by Firebase Analytics; the app shows no ads and does not use the
      advertising ID, so both the GMS and AdServices advertising-ID permissions are removed (and
      declared "no" in the Console).

  The corresponding Kotlin/resources live in src/github only; see docs/play/PLAN.md section 1.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Self-updater: install permission removed on Play -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <!-- Advertising ID removed on Play: pulled in by Firebase Analytics, but the app shows no ads
         and does not use the advertising ID. Declare "no" to the advertising-ID question. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />

    <!-- Overlay permission removed on Play: requested in onboarding but no system overlay is ever
         created (the floating mini player is in-app), so it is unused and Play-scrutinized. -->
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        tools:node="remove" />

    <!-- Removed on Play: declared but no boot receiver exists (vestigial). -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />

    <application>
        <!-- Self-updater: APK install-status receiver removed on Play -->
        <receiver
            android:name=".utils.updater.InstallReceiver"
            tools:node="remove" />

        <!-- Self-updater: Shizuku privileged-install provider removed on Play -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            tools:node="remove" />

        <!-- Accessibility button-mapper service removed on Play -->
        <service
            android:name=".accessibility.ButtonMapperAccessibilityService"
            tools:node="remove" />
    </application>
</manifest>
